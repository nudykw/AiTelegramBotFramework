# =============================================================================
# AiTelegramBotFramework — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Profiles
# -----------------------------------------------------------------------------
# Controls which optional services are started.
# Available values (comma-separated, no spaces):
#   postgres    — start PostgreSQL container
#   cloudbeaver — start CloudBeaver (web DB manager) container
#   aspire      — start .NET Aspire Dashboard (metrics/traces/logs UI)
#   nginx       — start Nginx reverse proxy (routes / → bot, /cloudbeaver/ → CloudBeaver)
# Examples:
#   COMPOSE_PROFILES=postgres,cloudbeaver,nginx   ← recommended for production
#   COMPOSE_PROFILES=postgres,cloudbeaver
#   COMPOSE_PROFILES=postgres,aspire
COMPOSE_PROFILES=postgres,cloudbeaver

# =============================================================================
# Bot Web Application
# =============================================================================

# Host port on which the bot web app (TelegramBotWebApp) will be available.
BOT_PORT=8080

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# Enable Swagger UI (Scalar) at /scalar/v1 and raw OpenAPI JSON at /openapi/v1.json.
# true  — always show Swagger (works in any environment, including Production)
# false — always hide Swagger
# (empty) — auto: shown in Development, hidden in Production
SWAGGER_ENABLED=false

# =============================================================================
# Telegram Bot Settings
# =============================================================================

# Bot token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram user ID of the bot owner (admin).
TELEGRAM_OWNER_ID=123456789

# Public base URL where your web app is reachable from the internet.
# Used to set the Telegram Webhook: {TELEGRAM_BASE_API_URL}/aibot
# If left empty, the bot runs in Polling mode instead.
# Trailing slash is optional — both formats are accepted:
#   https://example.com
#   https://example.com/
TELEGRAM_BASE_API_URL=

# Optional. Separate base URL specifically for the admin/thoughts dashboard.
# Useful in Polling mode when TELEGRAM_BASE_API_URL must be left empty.
# If left empty, it falls back to TELEGRAM_BASE_API_URL or dynamic localhost URL.
TELEGRAM_DASHBOARD_BASE_URL=

# =============================================================================
# Database — Active Provider
# =============================================================================

# The database provider to use.
# Supported values: PostgreSQL
DB_PROVIDER=PostgreSQL

# Full ADO.NET connection string for PostgreSQL.
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# =============================================================================
# PostgreSQL  (profile: postgres)
# =============================================================================

# Name of the database to create / connect to.
POSTGRES_DB=gpt_chat_bot

# PostgreSQL superuser / application user name.
POSTGRES_USER=postgres

# Password for the PostgreSQL user above.
POSTGRES_PASSWORD=change_me_strong_password

# Host port mapped to the PostgreSQL container's 5432.
POSTGRES_PORT=5432

# =============================================================================
# CloudBeaver  (profile: cloudbeaver)
# =============================================================================

# Host port on which CloudBeaver UI will be available.
# The same value is passed to CLOUDBEAVER_WEB_SERVER_PORT inside the container.
CLOUDBEAVER_PORT=8978

# Initial admin username for CloudBeaver (set on first launch).
CLOUDBEAVER_ADMIN_NAME=cbadmin

# Initial admin password for CloudBeaver.
# Must be ≥ 8 characters.
CLOUDBEAVER_ADMIN_PASSWORD=change_me_strong_password

# Activate OTel Java Agent for CloudBeaver (trace HTTP requests, JVM metrics).
# Set this ONLY when both 'aspire' and 'cloudbeaver' profiles are active.
# When empty, CloudBeaver starts without the agent (default, safe).
# With aspire+cloudbeaver profiles, set to:
#   CLOUDBEAVER_JAVA_TOOL_OPTIONS=-javaagent:/otel-agent/opentelemetry-javaagent.jar
CLOUDBEAVER_JAVA_TOOL_OPTIONS=

# =============================================================================
# Aspire Dashboard  (profile: aspire)
# =============================================================================

# Host port for the Aspire Dashboard browser UI.
ASPIRE_PORT=18888

# OTLP endpoint the bot will push telemetry to.
# Must point to the aspire-dashboard container on port 4317.
# Set automatically when using Docker Compose with the aspire profile.
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889

# =============================================================================
# Nginx Reverse Proxy  (profile: nginx)
# =============================================================================
# When the nginx profile is active, all services are accessible via a single
# address. Update your Cloudflare Tunnel to point to nginx instead of the bot.
#
#   /              → bot (TelegramBotWebApp)
#   /cloudbeaver/  → CloudBeaver
#
# Host port nginx will listen on.
NGINX_PORT=80

# =============================================================================
# Qdrant Vector Database
# =============================================================================
# Host ports mapped to the Qdrant container's 6333 and 6334.
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334

# =============================================================================
# Dashboard  (GET /)
# =============================================================================
# The dashboard page at / shows links to all active services.
# By default, links are built from the incoming Request.Host (works for LAN /
# direct-port access).
#
# If your services are exposed via custom subdomains (e.g. Cloudflare Tunnel),
# set these to override the auto-detected URLs on the dashboard:
#
#   CLOUDBEAVER_PUBLIC_URL — shown instead of {host}/cloudbeaver/
#   ASPIRE_PUBLIC_URL      — shown instead of {host}:{ASPIRE_PORT}
#
# Leave empty to use auto-detected URLs (recommended for local / Docker Compose).
# Set to the public IP/domain of your VPS so dashboard links work correctly.
# Example for IP-only access (no nginx):
CLOUDBEAVER_PUBLIC_URL=http://100.82.239.59:8978/cloudbeaver/
ASPIRE_PUBLIC_URL=http://100.82.239.59:18888

# =============================================================================
# Background Scheduler (Hangfire) & Long-term Memory (RAG)
# =============================================================================
# Enable/disable Hangfire background newsletter scheduler.
SCHEDULER_ENABLED=true

# Enable/disable Qdrant RAG semantic memory.
MEMORY_ENABLED=true

# URL to Qdrant inside the Docker container.
MEMORY_VECTOR_DB_URL=http://qdrant:6334

# Qdrant Memory provider, model and similarity threshold.
MEMORY_PROVIDER=Gemini
MEMORY_MODEL=text-embedding-004
MEMORY_SIMILARITY_THRESHOLD=0.5

# =============================================================================
# AI Provider API Keys
# =============================================================================
# These override the placeholder values from Configs/appsettings.sample.json.
# Index order matches ChatProviders array in that file:
#   0=OpenAI  1=Gemini  2=Grok  3=DeepSeek
# Leave a key empty to disable that provider.

OPENAI_API_KEY=sk-your_openai_key_here
GEMINI_API_KEY=AIzaSy-your_gemini_key_here
GROK_API_KEY=xai-your_grok_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# =============================================================================
# Google Drive MCP Settings
# =============================================================================
# AuthType: OAuth | ServiceAccount (defaults to OAuth if not set or set to OAuth)
AppSettings__GoogleDriveSettings__AuthType=OAuth
AppSettings__GoogleDriveSettings__ServiceAccountKeyPath=.secrets/.credentials.json
AppSettings__GoogleDriveSettings__ClientSecretsPath=.secrets/.gdrive-server-credentials.json
AppSettings__GoogleDriveSettings__TokenStorePath=.secrets/token_store
AppSettings__GoogleDriveSettings__RootFolderTemplate=AppWorkspace_{UserId}
AppSettings__GoogleDriveSettings__DefaultUserId=default

