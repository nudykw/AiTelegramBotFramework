{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Error"
    }
  },
  "AppSettings": {
    "TelegramBotConfiguration": {
      "BotToken": "<YOUR_TELEGRAM_BOT_TOKEN>",
      "OwnerId": 0,
      "DefaultParseMode": "Html",
      "InitialBalance": 0.1,
      "IgnoredBalanceUserIds": [],
      "BaseApiUrl": "",
      "DashboardBaseUrl": "",
      "AiSettings": {
        "Vision":         { "ModelName": "gpt-4o",    "ProviderName": "OpenAI" },
        "Drawing":        { "ModelName": "gpt-image-2",  "ProviderName": "OpenAI" },
        "Classification": { "ModelName": "gpt-4o",    "ProviderName": "OpenAI" },
        "ChatProviders": [
          { "Name": "OpenAI",   "ProviderType": "OpenAI",   "ApiKey": "<YOUR_OPENAI_KEY>",   "ModelName": "gpt-4o-mini" },
          { "Name": "Gemini",   "ProviderType": "Gemini",   "ApiKey": "<YOUR_GEMINI_KEY>",   "ModelName": "gemini-2.5-flash" },
          { "Name": "Grok",     "ProviderType": "Grok",     "ApiKey": "<YOUR_GROK_KEY>",     "ModelName": "grok-3-mini", "BaseUrl": "https://api.x.ai" },
          { "Name": "DeepSeek", "ProviderType": "DeepSeek", "ApiKey": "<YOUR_DEEPSEEK_KEY>", "ModelName": "deepseek-chat", "BaseUrl": "https://api.deepseek.com" }
        ]
      },
      "ModelCacheExpiryHours": 48,
      "AvailableVoices": [ "alloy", "echo", "fable", "onyx", "nova", "shimmer" ]
    },
    "Database": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Database=gpt_chat_bot;Username=postgres;Password=password"
    },
    "MemorySettings": {
      "Enabled": false,
      "VectorDbUrl": "http://localhost:16334",
      "ProviderName": "Gemini",
      "ModelName": "text-embedding-004",
      "TopK": 5,
      "SimilarityThreshold": 0.5,
      "MinMessageLength": 10
    },
    "Scheduler": {
      "Enabled": false
    },
    "GoogleDriveSettings": {
      "AuthType": "OAuth",
      "ServiceAccountKeyPath": ".secrets/.credentials.json",
      "ClientSecretsPath": ".secrets/.gdrive-server-credentials.json",
      "TokenStorePath": ".secrets/token_store",
      "RootFolderTemplate": "AppWorkspace_{UserId}",
      "DefaultUserId": "default"
    }
  }
}
